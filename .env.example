# Database
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_password
MYSQL_DATABASE=siem_db

# Flask app
SECRET_KEY=change_this_to_a_long_random_string
# Admin accounts: username:password pairs separated by commas
# Passwords cannot contain commas. Colons in passwords are fine.
USERS=admin:change_this,member2:change_this,member3:change_this,member4:change_this,member5:change_this

# Set to 1 for development, 0 for production
FLASK_DEBUG=0
