# ============================================================
# SIEM Dashboard Frontend — Environment Configuration
# ============================================================
# Copy this to .env and fill in the values.
# Hand this template to your groupmates — do NOT share
# any of Ayden's actual backend credentials.
# ============================================================

# Ayden's SIEM backend URL (ask him for his IP or hostname)
SIEM_URL=http://<AYDEN_IP>:5001

# Secret key for this dashboard's own session cookies.
# Each person running this can pick their own random string.
SIEM_DASHBOARD_SECRET=replace-with-something-random
